<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式变体：windowBackground 用深色底，避免边缘与冷启动白闪（Color.kt DarkDbColors.bg 同值） -->
    <style name="Theme.DrillBit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
    </style>
</resources>
